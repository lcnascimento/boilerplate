{
  "enabledPlugins": {
    "foundation@ai-foundation": true,
    "linear@claude-plugins-official": true,
    "notion@claude-plugins-official": true,
    "engineering@ai-foundation": true,
    "context7@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "ai-foundation": {
      "source": {
        "source": "github",
        "repo": "lcnascimento/ai-foundation"
      },
      "autoUpdate": true
    }
  },
  "permissions": {
    "allow": [
      "Bash(git grep *)",
      "mcp__linear__get_issue",
      "mcp__linear__list_comments",
      "mcp__linear__list_issue_labels",
      "mcp__linear__list_issues"
    ],
    "deny": [
      "Read(.secrets)",
      "Edit(.secrets)",
      "Read(.env*)",
      "Read(!.env.example)",
      "Read(~/.doppler/**)",
      "Bash(doppler *)",
      "Bash(tofu *)",
      "Bash(make iac.plan*)",
      "Bash(make iac.apply*)",
      "Bash(make iac.dev-token*)",
      "Bash(git commit*--no-verify*)",
      "Bash(*LEFTHOOK=0*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '[ -n \"$ZSH_VERSION\" ] && setopt nonomatch noequals' >> \"$CLAUDE_ENV_FILE\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-secrets.sh"
          }
        ]
      }
    ]
  }
}
