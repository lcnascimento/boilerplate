# -*- mode: Python -*-

minimal = os.getenv('TILT_STACK', '') == 'minimal'

local('make -s env')

compose_files = ['./docker-compose.yml']
if not minimal:
    compose_files.append('./docker-compose.observability.yml')
# Without wait=True, Tilt marks a compose resource ready once its container starts, ignoring its healthcheck.
docker_compose(compose_files, wait=True, profiles=[] if minimal else ['console'])

dc_resource('postgres', labels=['infrastructure'])

local_resource(
    'postgres-extensions',
    labels=['tooling'],
    cmd='docker compose run --rm --no-deps postgres-extensions',
    resource_deps=['postgres'],
)

dc_resource('kafka', labels=['infrastructure'])

dc_resource(
    'schema-registry',
    labels=['infrastructure'],
    resource_deps=['kafka'],
    links=[link('http://localhost:8081/subjects', 'API')],
)

if not minimal:
    dc_resource(
        'kafka-console',
        labels=['infrastructure'],
        resource_deps=['schema-registry'],
        links=[link('http://localhost:8085', 'UI')],
    )

    dc_resource(
        'alloy',
        labels=['monitoring'],
        resource_deps=['kafka', 'prometheus', 'loki', 'tempo', 'pyroscope'],
        links=[
            link('http://localhost:12345', 'UI'),
            link('http://localhost:4317', 'OTLP gRPC receiver'),
            link('http://localhost:4318', 'OTLP HTTP receiver'),
        ],
    )

    dc_resource(
        'prometheus',
        labels=['monitoring'],
        links=[link('http://localhost:9090', 'UI')],
    )

    dc_resource(
        'loki',
        labels=['monitoring'],
        links=[link('http://localhost:3100', 'API')],
    )

    dc_resource(
        'tempo',
        labels=['monitoring'],
        links=[link('http://localhost:3200', 'API')],
    )

    dc_resource(
        'pyroscope',
        labels=['monitoring'],
        links=[link('http://localhost:4040', 'UI / API')],
    )

    dc_resource(
        'grafana',
        labels=['monitoring'],
        resource_deps=['alloy', 'prometheus', 'loki', 'tempo', 'pyroscope'],
        links=[link('http://localhost:3010', 'UI')],
    )

    local_resource(
        'grafana-token',
        labels=['monitoring'],
        cmd='make -s grafana.token',
        resource_deps=['grafana'],
    )

include('./services/iam/Tiltfile')

# example:begin
include('./services/notes/Tiltfile')
include('./services/audit/Tiltfile')
# example:end
