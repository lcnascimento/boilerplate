      "title": "Traces Recentes",
      "type": "traces"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 10 },
      "id": 3,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [{ "datasource": { "type": "loki", "uid": "loki" }, "expr": "{service_name=~\".+\"} |~ \"(?i)(error|fatal|exception|panic)\"", "refId": "A" }],
      "title": "Logs de Erro (APM)",
      "type": "logs"
    },
    {
      "datasource": { "type": "tempo", "uid": "tempo" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue" }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 20 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["count"] },
        "textMode": "auto"
      },
      "targets": [{ "datasource": { "type": "tempo", "uid": "tempo" }, "limit": 100, "query": "{}", "queryType": "traceql", "refId": "A" }],
      "title": "Traces na Última Hora",
      "type": "stat"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green" }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 3 }]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 20 },
      "id": 5,
      "options": {
        "colorMode": "background",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "auto"
      },
      "targets": [{ "datasource": { "type": "loki", "uid": "loki" }, "expr": "count(sum by (service_name) (count_over_time({service_name=~\".+\"} |~ \"(?i)(error|fatal|exception|panic)\" [1h])))", "queryType": "instant", "refId": "A" }],
      "title": "Serviços com Erros (1h)",
      "type": "stat"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": { "custom": { "fillOpacity": 20, "lineWidth": 1 }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 20 },
      "id": 6,
      "targets": [{ "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum by (service_name) (rate({service_name=~\".+\"} |~ \"(?i)(error|fatal|exception|panic)\" [5m]))", "legendFormat": "{{service_name}}", "refId": "A" }],
      "title": "Volume de Erros por Serviço (5m)",
      "type": "timeseries"
    }
