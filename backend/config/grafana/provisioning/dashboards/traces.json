{
  "uid": "boilerplate-traces",
  "title": "Traces \u0026 Latência (APM)",
  "tags": [
    "traces",
    "apm",
    "tempo",
    "boilerplate"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 0,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "hidden": false,
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h",
      "2h",
      "1d"
    ]
  },
  "fiscalYearStartMonth": 0,
  "refresh": "30s",
  "schemaVersion": 42,
  "panels": [
    {
      "type": "nodeGraph",
      "id": 1,
      "targets": [
        {
          "refId": "A",
          "queryType": "serviceMap",
          "filters": [],
          "datasource": {
            "type": "tempo",
            "uid": "${tempo}"
          }
        }
      ],
      "title": "Service Map",
      "transparent": false,
      "datasource": {
        "type": "tempo",
        "uid": "${tempo}"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "repeatDirection": "h",
      "options": {}
    },
    {
      "type": "traces",
      "id": 2,
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{}",
          "limit": 20,
          "filters": [],
          "datasource": {
            "type": "tempo",
            "uid": "${tempo}"
          }
        }
      ],
      "title": "Traces Recentes",
      "transparent": false,
      "datasource": {
        "type": "tempo",
        "uid": "${tempo}"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "repeatDirection": "h",
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true
      }
    },
    {
      "type": "logs",
      "id": 3,
      "targets": [
        {
          "expr": "{service_name=~\".+\"} | detected_level=~\"error|critical|fatal\"",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          }
        }
      ],
      "title": "Logs de Erro (APM)",
      "transparent": false,
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "repeatDirection": "h",
      "options": {
        "showLabels": true,
        "showCommonLabels": false,
        "showTime": false,
        "showLogContextToggle": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "type": "stat",
      "id": 4,
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{}",
          "limit": 100,
          "filters": [],
          "datasource": {
            "type": "tempo",
            "uid": "${tempo}"
          }
        }
      ],
      "title": "Traces na Última Hora",
      "transparent": false,
      "datasource": {
        "type": "tempo",
        "uid": "${tempo}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 20
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "area",
        "colorMode": "background",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "count"
          ]
        },
        "percentChangeColorMode": "standard",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "blue"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "id": 5,
      "targets": [
        {
          "expr": "count(sum by (service_name) (count_over_time({service_name=~\".+\"} | detected_level=~\"error|critical|fatal\" [1h])))",
          "refId": "A",
          "queryType": "instant",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          }
        }
      ],
      "title": "Serviços com Erros (1h)",
      "transparent": false,
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 20
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "area",
        "colorMode": "background",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "percentChangeColorMode": "standard",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "yellow"
              },
              {
                "value": 3,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 6,
      "targets": [
        {
          "expr": "sum by (service_name) (rate({service_name=~\".+\"} | detected_level=~\"error|critical|fatal\" [5m]))",
          "legendFormat": "{{service_name}}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          }
        }
      ],
      "title": "Volume de Erros por Serviço (5m)",
      "transparent": false,
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 20
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 20
          }
        },
        "overrides": []
      }
    }
  ],
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "loki",
        "label": "Loki",
        "skipUrlSync": false,
        "query": "loki",
        "multi": false,
        "allowCustomValue": true,
        "includeAll": false,
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30
      },
      {
        "type": "datasource",
        "name": "tempo",
        "label": "Tempo",
        "skipUrlSync": false,
        "query": "tempo",
        "multi": false,
        "allowCustomValue": true,
        "includeAll": false,
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Annotations \u0026 Alerts",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "type": "dashboard",
        "builtIn": 1,
        "placement": "inControlsMenu"
      }
    ]
  }
}
