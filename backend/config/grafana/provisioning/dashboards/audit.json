    {
      "type": "row",
      "collapsed": true,
      "title": "Banco",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 50
      },
      "id": 18,
      "panels": [
        {
          "type": "timeseries",
          "id": 19,
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
                "uid": "${prometheus_datasource}"
              },
              "expr": "sum by (job) (pgxpool_acquired_connections{job=~\"boilerplate/$process\"})",
              "legendFormat": "em uso {{job}}",
              "refId": "A"
            },
            {
              "datasource": {
                "type": "prometheus",
                "uid": "${prometheus_datasource}"
              },
              "expr": "sum by (job) (pgxpool_max_connections{job=~\"boilerplate/$process\"})",
              "legendFormat": "máximo {{job}}",
              "refId": "B"
            }
