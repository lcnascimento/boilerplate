{
  "uid": "boilerplate-notes",
  "title": "notes",
  "description": "SLOs, alertas, uma seção por componente, runtime, banco e logs do serviço notes.",
  "tags": [
    "boilerplate",
    "service"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "hidden": false,
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h",
      "2h",
      "1d"
    ]
  },
  "fiscalYearStartMonth": 0,
  "refresh": "30s",
  "schemaVersion": 42,
  "panels": [
    {
      "type": "row",
      "collapsed": false,
      "title": "SLOs e alertas",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": []
    },
    {
      "type": "stat",
      "id": 2,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "1 - max by (sloth_slo) (slo:sli_error:ratio_rate5m{sloth_service=\"notes\"})",
          "legendFormat": "{{sloth_slo}}",
          "refId": "A"
        }
      ],
      "title": "SLI atual",
      "description": "Fração de eventos bons de cada SLO nos últimos 5 minutos, segundo as recording rules do Sloth.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "percentChangeColorMode": "standard",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "id": 3,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "max by (sloth_slo) (slo:period_error_budget_remaining:ratio{sloth_service=\"notes\"})",
          "legendFormat": "{{sloth_slo}}",
          "refId": "A"
        }
      ],
      "title": "Budget restante (30d)",
      "description": "Fração do error budget de 30 dias que cada SLO ainda tem; abaixo de zero, o SLO já foi descumprido na janela.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "percentChangeColorMode": "standard",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 0,
                "color": "yellow"
              },
              {
                "value": 0.25,
                "color": "green"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "id": 4,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "max by (sloth_slo) (slo:current_burn_rate:ratio{sloth_service=\"notes\"})",
          "legendFormat": "{{sloth_slo}}",
          "refId": "A"
        }
      ],
      "title": "Burn rate",
      "description": "Velocidade com que cada SLO queima o budget nos últimos 5 minutos: 1 gasta o budget exatamente em 30 dias.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "percentChangeColorMode": "standard",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "yellow"
              },
              {
                "value": 6,
                "color": "red"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "alertlist",
      "id": 5,
      "title": "Alertas do serviço",
      "description": "Alertas de cada processo de notes, inclusive os de burn rate dos SLOs.",
      "transparent": false,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "repeatDirection": "h",
      "options": {
        "alertInstanceLabelFilter": "{service=~\"notes-.*\"}",
        "alertName": "",
        "dashboardAlerts": false,
        "groupBy": [],
        "groupMode": "default",
        "maxItems": 20,
        "showInstances": true,
        "sortOrder": 1,
        "stateFilter": {
          "error": true,
          "firing": true,
          "noData": true,
          "normal": true,
          "pending": true,
          "recovering": true
        },
        "viewMode": "list"
      }
    },
    {
      "type": "row",
