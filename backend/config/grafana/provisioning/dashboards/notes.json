          "expr": "sum (rate(http_server_request_total{job=~\"boilerplate/(notes-api-frontend)\", http_route!~\"/ping|/health\"}[$__rate_interval]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Taxa",
      "description": "Requisições por segundo, fora as de health e readiness.",
      "transparent": false,
      "datasource": {
