{
  "uid": "boilerplate-overview",
  "title": "Overview",
  "tags": [
    "boilerplate",
    "overview"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "hidden": false,
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h",
      "2h",
      "1d"
    ]
  },
  "fiscalYearStartMonth": 0,
  "refresh": "30s",
  "schemaVersion": 42,
  "panels": [
    {
      "type": "table",
      "id": 1,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "max by (sloth_service, sloth_slo, service) (slo:objective:ratio)",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "1 - max by (sloth_service, sloth_slo, service) (slo:sli_error:ratio_rate30d)",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "max by (sloth_service, sloth_slo, service) (slo:period_error_budget_remaining:ratio)",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "max by (sloth_service, sloth_slo, service) (slo:current_burn_rate:ratio)",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "D"
        }
      ],
      "title": "SLOs",
      "description": "Todo SLO de todo serviço: objetivo, SLI e budget restante na janela de 30 dias, e o burn rate atual (1 = queima o budget exatamente em 30 dias). O nome do serviço abre o dashboard dele.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "repeatDirection": "h",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "Value #A": 3,
              "Value #B": 4,
              "Value #C": 5,
              "Value #D": 6,
              "service": 2,
              "sloth_service": 0,
              "sloth_slo": 1
            },
            "renameByName": {
              "Value #A": "Objetivo",
              "Value #B": "SLI (30d)",
              "Value #C": "Budget restante (30d)",
              "Value #D": "Burn rate",
              "service": "Processo",
              "sloth_service": "Serviço",
              "sloth_slo": "SLO"
            }
          }
        }
      ],
      "options": {
        "frameIndex": 0,
        "showHeader": true,
        "showTypeIcons": false,
        "footer": {
          "show": false,
          "reducer": null,
          "countRows": false
        },
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "align": "auto",
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Serviço"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Dashboard do serviço",
                    "url": "/d/boilerplate-${__value.raw}?${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Objetivo"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "SLI (30d)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Budget restante (30d)"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 0
                    },
                    {
                      "color": "green",
                      "value": 0.25
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Burn rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 6
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "alertlist",
      "id": 2,
      "title": "Alertas ativos",
      "description": "Todos os alertas que estão disparando, pendentes ou com erro de avaliação, de todos os serviços e da infraestrutura.",
      "transparent": false,
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "repeatDirection": "h",
      "options": {
        "alertInstanceLabelFilter": "",
        "alertName": "",
        "dashboardAlerts": false,
        "groupBy": [],
        "groupMode": "default",
        "maxItems": 50,
        "showInstances": false,
        "sortOrder": 1,
        "stateFilter": {
          "error": true,
          "firing": true,
          "noData": true,
          "normal": false,
          "pending": true,
          "recovering": true
        },
        "viewMode": "list"
      }
    },
    {
      "type": "nodeGraph",
      "id": 3,
      "targets": [
        {
          "refId": "A",
          "queryType": "serviceMap",
          "filters": [],
          "datasource": {
            "type": "tempo",
            "uid": "${tempo_datasource}"
          }
        }
      ],
      "title": "Service map",
      "description": "Chamadas entre serviços vistas nos traces, com taxa e latência, a partir do metrics-generator do Tempo.",
      "transparent": false,
      "datasource": {
        "type": "tempo",
        "uid": "${tempo_datasource}"
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "repeatDirection": "h",
      "options": {}
    }
  ],
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "tempo_datasource",
        "label": "Tempo data source",
        "skipUrlSync": false,
        "query": "tempo",
        "multi": false,
        "allowCustomValue": true,
        "includeAll": false,
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30
      },
      {
        "type": "datasource",
        "name": "prometheus_datasource",
        "label": "Prometheus data source",
        "skipUrlSync": false,
        "query": "prometheus",
        "multi": false,
        "allowCustomValue": true,
        "includeAll": false,
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Annotations \u0026 Alerts",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "type": "dashboard",
        "builtIn": 1,
        "placement": "inControlsMenu"
      }
    ]
  },
  "links": [
    {
      "title": "Dashboards",
      "type": "dashboards",
      "icon": "external link",
      "tooltip": "",
      "tags": [
        "boilerplate"
      ],
      "asDropdown": false,
      "placement": "inControlsMenu",
      "targetBlank": false,
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "Kafka",
      "type": "link",
      "icon": "dashboard",
      "tooltip": "",
      "url": "/d/boilerplate-kafka",
      "tags": [],
      "asDropdown": false,
      "placement": "inControlsMenu",
      "targetBlank": false,
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "Postgres",
      "type": "link",
      "icon": "dashboard",
      "tooltip": "",
      "url": "/d/boilerplate-postgres",
      "tags": [],
      "asDropdown": false,
      "placement": "inControlsMenu",
      "targetBlank": false,
      "includeVars": false,
      "keepTime": true
    }
  ]
}
