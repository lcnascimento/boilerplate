  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "prometheus",
        "label": "Prometheus",
        "skipUrlSync": false,
        "query": "prometheus",
        "multi": false,
        "allowCustomValue": true,
        "includeAll": false,
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30
      },
      {
        "type": "query",
        "name": "service",
        "label": "Serviço",
        "skipUrlSync": false,
        "query": "label_values(http_server_request_total, job)",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "multi": true,
        "allowCustomValue": true,
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".+",
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30,
        "definition": "label_values(http_server_request_total, job)"
      }
    ]
  },
  "annotations": {
