{
  "uid": "boilerplate-http",
  "title": "HTTP APIs — Rate · Errors · Duration",
  "tags": [
    "http",
    "red",
    "boilerplate",
    "sre"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 0,
  "time": {
    "from": "now-1h",
    "to": "now"
