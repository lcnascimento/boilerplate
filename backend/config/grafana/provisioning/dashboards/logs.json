{
  "uid": "boilerplate-logs",
  "title": "Logs Explorer",
  "tags": [
    "boilerplate",
    "logs"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 0,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "hidden": false,
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h",
      "2h",
      "1d"
    ]
  },
  "fiscalYearStartMonth": 0,
  "refresh": "30s",
  "schemaVersion": 42,
  "panels": [
    {
      "type": "stat",
      "id": 1,
      "targets": [
        {
          "expr": "sum(count_over_time({service_name=~\"${service:regex}\", container=~\"${container:regex}\"} [$__auto]))",
          "instant": true,
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "title": "Total Logs",
      "description": "Linhas de log no intervalo selecionado.",
      "transparent": false,
      "datasource": {
        "type": "loki",
        "uid": "${loki_datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "percentChangeColorMode": "standard",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "blue"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "id": 2,
      "targets": [
        {
          "expr": "sum(count_over_time({service_name=~\"${service:regex}\", container=~\"${container:regex}\"} | detected_level=\"error\" [$__auto]))",
          "instant": true,
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "title": "Total Errors",
      "description": "Linhas de log com nível error no intervalo selecionado.",
      "transparent": false,
      "datasource": {
        "type": "loki",
        "uid": "${loki_datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "percentChangeColorMode": "standard",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 10,
                "color": "yellow"
              },
              {
                "value": 50,
                "color": "red"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "id": 3,
      "targets": [
        {
          "expr": "sum(count_over_time({service_name=~\"${service:regex}\", container=~\"${container:regex}\"} | detected_level=\"warn\" [$__auto]))",
          "instant": true,
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "title": "Total Warnings",
      "description": "Linhas de log com nível warn no intervalo selecionado.",
      "transparent": false,
      "datasource": {
        "type": "loki",
        "uid": "${loki_datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "percentChangeColorMode": "standard",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 20,
                "color": "yellow"
              },
              {
                "value": 100,
                "color": "orange"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 4,
      "targets": [
        {
          "expr": "sum by (service_name) (count_over_time({service_name=~\"${service:regex}\", container=~\"${container:regex}\"} [$__auto]))",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ],
      "title": "Log Volume by Service",
      "description": "Linhas de log por service_name ao longo do tempo.",
      "transparent": false,
      "datasource": {
        "type": "loki",
        "uid": "${loki_datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 5,
      "targets": [
        {
          "expr": "sum by (service_name) (count_over_time({service_name=~\"${service:regex}\", container=~\"${container:regex}\"} | detected_level=~\"error|critical|fatal\" [$__auto]))",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ],
      "title": "Errors by Service",
      "description": "Linhas de log com error, critical ou fatal, por service_name, ao longo do tempo.",
      "transparent": false,
      "datasource": {
        "type": "loki",
        "uid": "${loki_datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "logs",
      "id": 6,
      "targets": [
        {
          "expr": "{service_name=~\"${service:regex}\", container=~\"${container:regex}\"}",
          "refId": "A"
        }
      ],
      "title": "All Logs",
      "transparent": false,
      "datasource": {
        "type": "loki",
        "uid": "${loki_datasource}"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "repeatDirection": "h",
      "options": {
        "showLabels": true,
        "showCommonLabels": false,
        "showTime": true,
        "showLogContextToggle": false,
        "wrapLogMessage": false,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "type": "logs",
      "id": 7,
      "targets": [
        {
          "expr": "{service_name=~\"${service:regex}\", container=~\"${container:regex}\"} | detected_level=~\"error|critical|fatal\"",
          "refId": "A"
        }
      ],
      "title": "Error Logs",
      "transparent": false,
      "datasource": {
        "type": "loki",
        "uid": "${loki_datasource}"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "repeatDirection": "h",
      "options": {
        "showLabels": true,
        "showCommonLabels": false,
        "showTime": true,
        "showLogContextToggle": false,
        "wrapLogMessage": false,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    }
  ],
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "loki_datasource",
        "label": "Loki data source",
        "skipUrlSync": false,
        "query": "loki",
        "multi": false,
        "allowCustomValue": true,
        "includeAll": false,
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30
      },
      {
        "type": "query",
        "name": "service",
        "label": "Service",
        "hide": 0,
        "skipUrlSync": false,
        "query": "label_values(service_name)",
        "datasource": {
          "type": "loki",
          "uid": "${loki_datasource}"
        },
        "current": {
          "text": null,
          "value": null
        },
        "multi": true,
        "allowCustomValue": true,
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".+",
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30,
        "definition": "label_values(service_name)"
      },
      {
        "type": "query",
        "name": "container",
        "label": "Container",
        "hide": 0,
        "skipUrlSync": false,
        "query": "label_values(container)",
        "datasource": {
          "type": "loki",
          "uid": "${loki_datasource}"
        },
        "current": {
          "text": null,
          "value": null
        },
        "multi": true,
        "allowCustomValue": true,
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30,
        "definition": "label_values(container)"
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Annotations \u0026 Alerts",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "type": "dashboard",
        "builtIn": 1,
        "placement": "inControlsMenu"
      }
    ]
  }
}
