discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"

  filter {
    name   = "network"
    values = ["boilerplate"]
  }
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_image"]
    target_label  = "image"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [otelcol.receiver.loki.containers.receiver]
}

otelcol.receiver.loki "containers" {
  output {
    logs = [otelcol.processor.transform.containers.input]
  }
}

// Container logs reach Loki in the shape of the services' OTLP logs: the message as the line, the level as the
// severity, and the other fields as structured metadata. A line in an unknown format keeps its text.
otelcol.processor.transform "containers" {
  error_mode = "ignore"

  log_statements {
    context    = "log"
    statements = [
      `set(resource.attributes["service.name"], log.attributes["service"])`,
      `set(resource.attributes["service.name"], log.attributes["container"]) where log.attributes["service"] == nil`,
      `set(resource.attributes["container.name"], log.attributes["container"])`,
      `set(resource.attributes["container.image.name"], log.attributes["image"])`,
      `delete_matching_keys(log.attributes, "^(service|container|image|loki\\.attribute\\.labels)$")`,
      // JSON (kafka-console).
      `merge_maps(log.cache, ParseJSON(log.body), "upsert") where IsMatch(log.body, "^\\{")`,
      // logfmt (alloy, grafana, loki, prometheus, pyroscope, tempo).
      `merge_maps(log.cache, ParseKeyValue(log.body), "upsert") where IsMatch(log.body, "^[A-Za-z_][A-Za-z0-9_.]*=")`,
      // log4j (kafka, schema-registry): [timestamp] LEVEL message (logger)
      `merge_maps(log.cache, ExtractPatterns(log.body, "^\\[[^\\]]+\\] (?P<level>[A-Z]+) (?P<msg>.*?)(?: \\((?P<logger>[^()]+)\\))?$"), "upsert") where IsMatch(log.body, "^\\[\\d{4}-\\d{2}-\\d{2} [^\\]]+\\] [A-Z]+ ")`,
      // postgres: timestamp [pid] LEVEL:  message; DETAIL, HINT and STATEMENT lines keep their prefix in the message.
      `merge_maps(log.cache, ExtractPatterns(log.body, "^\\d{4}-\\d{2}-\\d{2} \\S+ \\S+ \\[(?P<pid>\\d+)\\] (?:(?P<level>DEBUG[1-5]|LOG|INFO|NOTICE|WARNING|ERROR|FATAL|PANIC):\\s+)?(?P<msg>.*)$"), "upsert") where IsMatch(log.body, "^\\d{4}-\\d{2}-\\d{2} \\S+ \\S+ \\[\\d+\\] ")`,
      `set(log.cache["msg"], log.cache["message"]) where log.cache["msg"] == nil`,
      `set(log.cache["level"], log.cache["lvl"]) where log.cache["level"] == nil`,
      `set(log.cache["level"], ToUpperCase(log.cache["level"])) where log.cache["level"] != nil`,
      `set(log.severity_text, "TRACE") where log.cache["level"] == "TRACE"`,
      `set(log.severity_text, "DEBUG") where log.cache["level"] != nil and IsMatch(log.cache["level"], "^DEBUG[1-5]?$")`,
      `set(log.severity_text, "INFO") where log.cache["level"] != nil and IsMatch(log.cache["level"], "^(INFO|LOG|NOTICE)$")`,
      `set(log.severity_text, "WARN") where log.cache["level"] != nil and IsMatch(log.cache["level"], "^WARN(ING)?$")`,
      `set(log.severity_text, "ERROR") where log.cache["level"] != nil and IsMatch(log.cache["level"], "^(ERROR|ERR|EROR)$")`,
      `set(log.severity_text, "FATAL") where log.cache["level"] != nil and IsMatch(log.cache["level"], "^(FATAL|PANIC|CRIT|CRITICAL)$")`,
      `set(log.severity_number, SEVERITY_NUMBER_TRACE) where log.severity_text == "TRACE"`,
      `set(log.severity_number, SEVERITY_NUMBER_DEBUG) where log.severity_text == "DEBUG"`,
      `set(log.severity_number, SEVERITY_NUMBER_INFO) where log.severity_text == "INFO"`,
      `set(log.severity_number, SEVERITY_NUMBER_WARN) where log.severity_text == "WARN"`,
      `set(log.severity_number, SEVERITY_NUMBER_ERROR) where log.severity_text == "ERROR"`,
      `set(log.severity_number, SEVERITY_NUMBER_FATAL) where log.severity_text == "FATAL"`,
      `delete_matching_keys(log.cache, "^(level|lvl|message|ts|t|time|timestamp)$")`,
      `merge_maps(log.attributes, log.cache, "insert") where log.cache["msg"] != nil`,
      `set(log.body, log.cache["msg"]) where log.cache["msg"] != nil`,
      `delete_key(log.attributes, "msg")`,
    ]
  }

  output {
    logs = [otelcol.processor.batch.containers.input]
  }
}

// otelcol.receiver.loki emits one request per line, which overflows the exporter queue on a burst.
otelcol.processor.batch "containers" {
  output {
    logs = [otelcol.exporter.otlphttp.loki.input]
  }
}

otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    metrics = [otelcol.exporter.otlphttp.prometheus.input]
    traces  = [otelcol.processor.filter.drop_infra_noise.input]
    logs    = [otelcol.exporter.otlphttp.loki.input]
  }
}

otelcol.processor.filter "drop_infra_noise" {
  error_mode = "ignore"

  traces {
    span = [
      `attributes["http.route"] == "/ping"`,
      `attributes["http.route"] == "/health"`,
    ]
  }

  output {
    traces = [otelcol.processor.transform.peer_service.input]
  }
}

// Tempo's service graph names a database after server.address (localhost for a process on the host) and a broker
// only after peer.service. Creating a message writes the outbox, not Kafka, so it gets no broker peer.
otelcol.processor.transform "peer_service" {
  error_mode = "ignore"

  trace_statements {
    context    = "span"
    statements = [
      `set(span.attributes["peer.service"], "postgres") where span.attributes["db.system.name"] == "postgresql" and span.attributes["peer.service"] == nil`,
      `set(span.attributes["peer.service"], "kafka") where span.attributes["messaging.system"] == "kafka" and span.attributes["messaging.operation.type"] != "create" and span.attributes["peer.service"] == nil`,
    ]
  }

  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

faro.receiver "web" {
  server {
    listen_address       = "0.0.0.0"
    listen_port          = 12347
    cors_allowed_origins = ["http://localhost:3000"]
  }

  sourcemaps {
    download = false
  }

  output {
    logs   = [otelcol.receiver.loki.faro.receiver]
    traces = [otelcol.processor.filter.drop_infra_noise.input]
  }
}

otelcol.receiver.loki "faro" {
  output {
    logs = [otelcol.processor.transform.faro.input]
  }
}

// faro.receiver writes each signal as a logfmt line without labels: its fields become structured metadata, and the
// Faro app becomes the OTLP service.
otelcol.processor.transform "faro" {
  error_mode = "ignore"

  log_statements {
    context    = "log"
    statements = [
      `merge_maps(log.attributes, ParseKeyValue(log.body), "upsert")`,
      `set(resource.attributes["service.name"], log.attributes["app_name"])`,
      `set(resource.attributes["service.namespace"], log.attributes["app_namespace"])`,
    ]
  }

  output {
    logs = [otelcol.exporter.otlphttp.loki.input]
  }
}

prometheus.exporter.kafka "local_kafka" {
  kafka_uris          = ["kafka:19092"]
  topics_filter_regex = "^[^_].*"
}

prometheus.scrape "kafka" {
  targets         = prometheus.exporter.kafka.local_kafka.targets
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.local_prometheus.receiver]
}

prometheus.exporter.postgres "local_postgres" {
  data_source_names          = ["postgresql://postgres:postgres@postgres:5432/postgres?sslmode=disable"]
  // No built-in collector counts connections by role and application_name.
  custom_queries_config_path = "/etc/alloy/postgres-queries.yaml"
  enabled_collectors         = ["database", "locks", "replication", "replication_slot", "stat_bgwriter", "stat_checkpointer", "stat_database", "stat_statements", "wal"]
}

prometheus.scrape "postgres" {
  targets         = prometheus.exporter.postgres.local_postgres.targets
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.drop_test_databases.receiver]
}

// The exporter's database denylist takes exact names, not the per-test testdb_* databases pgtestdb creates.
prometheus.relabel "drop_test_databases" {
  forward_to = [prometheus.remote_write.local_prometheus.receiver]

  rule {
    source_labels = ["datname"]
    regex         = "testdb_.*"
    action        = "drop"
  }
}

prometheus.remote_write "local_prometheus" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}

otelcol.exporter.otlphttp "prometheus" {
  client {
    endpoint = "http://prometheus:9090/api/v1/otlp"
  }
}

otelcol.exporter.otlphttp "loki" {
  client {
    endpoint = "http://loki:3100/otlp"
  }
}
