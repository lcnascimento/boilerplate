OTEL_SERVICE_NAME=boilerplate
OTEL_RESOURCE_ATTRIBUTES=service.version=v0.1.0,service.namespace=boilerplate,deployment.environment=local

OTEL_LOGS_EXPORTER=otlp
OTEL_LOG_HANDLER=otelslog

OTEL_PROFILES_EXPORTER=pyroscope
OTEL_EXPORTER_PYROSCOPE_ENDPOINT=http://localhost:4040

POSTGRES_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable
