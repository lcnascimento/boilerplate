# -*- mode: Python -*-

local_resource(
    'notes-api-frontend',
    labels=['notes'],
    cmd='make build.api.frontend -s',
    serve_cmd='make run.api.frontend -s',
    deps=['.env', '../../.env', 'bundle/', 'cmd/', 'internal/', 'pkg/', 'go.mod'],
    ignore=['./**/mocks/', 'coverage*'],
    trigger_mode=TRIGGER_MODE_AUTO,
    allow_parallel=True,
    links=[link('http://localhost:8080/health', 'health')],
    readiness_probe=probe(
        period_secs=5,
        failure_threshold=10,
        http_get=http_get_action(port=8080, path='/health'),
    ),
)
