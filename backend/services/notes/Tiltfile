# -*- mode: Python -*-

local_resource(
    'notes-db',
    labels=['tooling'],
    cmd='make db.setup -s',
    resource_deps=['postgres'],
)

local_resource(
    'notes-topics',
    labels=['tooling'],
    cmd='make kafka.topics -s',
    deps=['Makefile'],
    resource_deps=['schema-registry'],
)

local_resource(
    'notes-schemas',
    labels=['tooling'],
    cmd='make schemas.register -s',
    deps=['.env', '../../.env', 'pkg/events/', 'cmd/schemas/', 'bundle/schemas.go'],
    ignore=['./**/*_test.go', 'pkg/events/testdata/', 'pkg/events/eventstest/'],
    resource_deps=['schema-registry'],
)

local_resource(
    'notes-migrate',
    labels=['tooling'],
    cmd='make db.migrate -s',
    deps=['.env', '../../.env', 'internal/repository/migrations/', 'cmd/migrate/'],
    ignore=['./**/*_test.go'],
    resource_deps=['notes-db'],
)

local_resource(
    'notes-api-frontend',
    labels=['backend'],
    cmd='make build.api.frontend -s',
    serve_cmd='make run.api.frontend -s',
    deps=['.env', '../../.env', 'bundle/', 'cmd/', 'internal/', 'pkg/', 'go.mod'],
    ignore=['./**/mocks/', 'coverage*', 'cmd/migrate/', 'internal/repository/migrations/'],
    resource_deps=['notes-migrate', 'notes-schemas'],
    trigger_mode=TRIGGER_MODE_AUTO,
    allow_parallel=True,
    links=[link('http://localhost:8080/health', 'health')],
    readiness_probe=probe(
        period_secs=5,
        failure_threshold=10,
        http_get=http_get_action(port=8080, path='/health'),
    ),
)

local_resource(
    'notes-worker-forwarder',
    labels=['backend'],
    cmd='make build.worker.forwarder -s',
    serve_cmd='make run.worker.forwarder -s',
    deps=['.env', '../../.env', 'bundle/', 'cmd/', 'internal/', 'pkg/', 'go.mod'],
    ignore=['./**/mocks/', 'coverage*', 'cmd/migrate/', 'internal/repository/migrations/'],
    resource_deps=['notes-migrate', 'notes-topics'],
    trigger_mode=TRIGGER_MODE_AUTO,
    allow_parallel=True,
    links=[link('http://localhost:8091/health', 'health')],
    readiness_probe=probe(
        period_secs=5,
        failure_threshold=10,
        http_get=http_get_action(port=8091, path='/health'),
    ),
)

local_resource(
    'notes-consumer',
    labels=['backend'],
    cmd='make build.consumer -s',
    serve_cmd='make run.consumer -s',
    deps=['.env', '../../.env', 'bundle/', 'cmd/', 'internal/', 'pkg/', 'go.mod', '../iam/pkg/eventbus/', '../iam/pkg/events/'],
    ignore=['./**/mocks/', 'coverage*', 'cmd/migrate/', 'internal/repository/migrations/', './**/*_test.go'],
    resource_deps=['notes-migrate', 'notes-schemas', 'notes-topics', 'iam-topics'],
    trigger_mode=TRIGGER_MODE_AUTO,
    allow_parallel=True,
    links=[link('http://localhost:8094/health', 'health')],
    readiness_probe=probe(
        period_secs=5,
        failure_threshold=10,
        http_get=http_get_action(port=8094, path='/health'),
    ),
)
