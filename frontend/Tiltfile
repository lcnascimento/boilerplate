# -*- mode: Python -*-

local_resource(
    'frontend-deps',
    cmd='pnpm install',
    deps=['package.json', 'pnpm-lock.yaml', 'pnpm-workspace.yaml'],
    labels=['frontend'],
)

MINIMAL_STACK = os.getenv('TILT_STACK', '') == 'minimal'

local('make -s env')

iam_env = {
    'IAM_DATABASE_URL': 'postgres://iam:iam@localhost:5432/iam?sslmode=disable',
    # Dev only: production must use its own secret.
    'BETTER_AUTH_SECRET': 'dev-only-secret-change-me-in-production',
    'BETTER_AUTH_URL': 'http://localhost:3000',
}

local_resource(
    'iam-seed',
    cmd='pnpm --filter @boilerplate/web iam:seed',
    env=iam_env,
    deps=['apps/web/scripts/iam-seed/'],
    resource_deps=['frontend-deps', 'iam-migrate'],
    labels=['iam'],
)

web_deps = ['frontend-deps', 'iam-seed']

web_env = dict(iam_env)
web_env.update({
    'OTEL_SERVICE_NAME': 'web',
    'OTEL_RESOURCE_ATTRIBUTES': 'service.version=v0.1.0,service.namespace=boilerplate,deployment.environment=local',
    # Otherwise Next opens a second client span beside undici's on every fetch.
    'NEXT_OTEL_FETCH_DISABLED': '1',
    # example:begin
    'NOTES_API_URL': 'http://localhost:8080',
    # example:end
})

if not MINIMAL_STACK:
    web_env['NEXT_PUBLIC_FARO_URL'] = 'http://localhost:12347/collect'
    # The OTLP exporter gives up after ~10s, so a log written before Alloy listens is lost.
    web_deps.append('alloy')

local_resource(
    'web',
    serve_cmd='pnpm --filter @boilerplate/web dev',
    serve_env=web_env,
    resource_deps=web_deps,
    # TCP, not HTTP: an HTTP probe logs the whole page on every success.
    readiness_probe=probe(
        period_secs=5,
        tcp_socket=tcp_socket_action(port=3000),
    ),
    links=[link('http://localhost:3000', 'App')],
    labels=['frontend'],
)

PLAYWRIGHT_UI_PORT = 9330

if not MINIMAL_STACK:
    local_resource(
        'web-e2e-ui',
        serve_cmd='pnpm --filter @boilerplate/web test:e2e --ui-port={} --ui-host=127.0.0.1'.format(PLAYWRIGHT_UI_PORT),
        resource_deps=[
            'web',
            # example:begin
            'notes-api-frontend',
            # example:end
        ],
        auto_init=False,
        trigger_mode=TRIGGER_MODE_MANUAL,
        readiness_probe=probe(
            period_secs=5,
            tcp_socket=tcp_socket_action(port=PLAYWRIGHT_UI_PORT),
        ),
        links=[link('http://127.0.0.1:{}'.format(PLAYWRIGHT_UI_PORT), 'Playwright UI')],
        labels=['frontend'],
    )
