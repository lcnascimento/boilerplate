    "test:e2e": "playwright test",
    "iam:seed": "tsx scripts/iam-seed/index.ts",
    "iam:token": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/iam-token/index.ts",
    "iam:check-schema": "tsx scripts/iam-check-schema/index.ts"
  },
  "dependencies": {
    "@better-auth/core": "1.7.12",
